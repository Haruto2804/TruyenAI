# ====================================================================
# TRUYENAI ENVIRONMENT VARIABLES TEMPLATE (FOR LOCAL & VERCEL DEPLOYMENT)
# ====================================================================

# 1. DATABASE (PostgreSQL for Production on Neon.tech / Supabase.com)
DATABASE_URL="postgresql://username:password@host:5432/database?sslmode=require"

# 2. NEXTAUTH / AUTH.JS SECRET
AUTH_SECRET="your-32-char-random-secret-key"
AUTH_TRUST_HOST="true"

# 3. GOOGLE OAUTH CREDENTIALS (Google Cloud Console)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# 4. CLOUDINARY MEDIA STORAGE (Optional, for avatar & cover uploads)
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# 5. ADMIN AUTHORIZATION
ADMIN_EMAILS="admin@example.com"
