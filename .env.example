# ====================================================================
# TRUYENAI ENVIRONMENT VARIABLES (FOR LOCAL & VERCEL DEPLOYMENT)
# ====================================================================

# 1. DATABASE (PostgreSQL for Production on Neon.tech / Supabase.com)
# Example Neon: postgresql://username:password@ep-cool-fog-12345.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# 2. NEXTAUTH / AUTH.JS SECRET
# Generate with: openssl rand -base64 32 or random string
AUTH_SECRET="your-32-char-random-secret-key"
AUTH_TRUST_HOST="true"

# 3. GOOGLE OAUTH CREDENTIALS (Google Cloud Console)
# Redirect URI on Vercel: https://your-domain.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# 4. CLOUDINARY MEDIA STORAGE (Optional, for avatar & cover uploads)
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# 5. ADMIN AUTHORIZATION
ADMIN_EMAILS="your-email@gmail.com"
